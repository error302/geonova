# Metardu Caddy Reverse Proxy Configuration
# ============================================
# Automatic HTTPS via Let's Encrypt / ZeroSSL
# SSL termination and reverse proxy to Next.js
#
# Security headers (HSTS, CSP, Permissions-Policy, etc.) are handled
# by Next.js middleware (middleware.ts) — NOT here. This avoids
# duplicate headers which confuse some CDNs and browsers.

{$DOMAIN:metardu.space} {
	# Reverse proxy to Next.js app
	reverse_proxy web:3000

	# NTRIP WebSocket proxy path
	handle_path /ntrip/* {
		reverse_proxy ntrip_proxy:8090
	}

	# Collaboration WebSocket proxy
	handle /ws/* {
		reverse_proxy collaboration:3001 {
			transport http {
				read_timeout 86400s
				write_timeout 86400s
			}
		}
	}

	# Compression
	encode gzip zstd

	# Logging
	log {
		output stdout
		format console
	}
}

# HTTP → HTTPS redirect (Caddy handles this automatically, but explicit for clarity)
http://{$DOMAIN:metardu.space} {
	redir https://{host}{uri} permanent
}
