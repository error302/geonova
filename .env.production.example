# METARDU Production Environment Configuration
# Copy to .env.production and fill in your values

# ─── Core ───
DATABASE_URL=postgresql://metardu:YOUR_PASSWORD@localhost:5432/metardu
AUTH_SECRET=YOUR_32_CHAR_SECRET_HERE
NEXTAUTH_URL=https://metardu.space
NEXT_PUBLIC_APP_URL=https://metardu.space
NEXT_PUBLIC_WS_URL=wss://metardu.space/ws/collaboration

# ─── OAuth Providers (optional but recommended) ───
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AZURE_AD_CLIENT_ID=your-azure-app-id
AZURE_AD_CLIENT_SECRET=your-azure-secret
AZURE_AD_TENANT_ID=common

# ─── Admin ───
ADMIN_EMAILS=admin@metardu.com
PLATFORM_OWNER_EMAIL=owner@metardu.com

# ─── Payments ───
# M-Pesa Daraja API (Safaricom).
# NOTE: variable names must match exactly what src/lib/payments/mpesa.ts reads:
#   MPESA_SHORT_CODE (with underscore) and MPESA_ENV — NOT MPESA_SHORTCODE /
#   MPESA_ENVIRONMENT. Wrong names silently leave M-Pesa disabled/sandbox.
MPESA_CONSUMER_KEY=your-mpesa-key
MPESA_CONSUMER_SECRET=your-mpesa-secret
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=your-passkey
MPESA_INITIATOR_NAME=your-initiator-name
MPESA_SECURITY_CREDENTIAL=your-security-credential
MPESA_ENV=production
# Optional: override Safaricom callback IP whitelist (comma-separated)
# MPESA_CALLBACK_IP_WHITELIST=196.201.214.200,196.201.214.206

# Stripe
STRIPE_SECRET_KEY=sk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-key

# PayPal
# PAYPAL_MODE MUST be explicitly set to "live" for production — it defaults to
# sandbox otherwise (never auto-detected from NODE_ENV, by design).
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_MODE=live
# REQUIRED in live mode: webhook signature verification fails closed without it.
PAYPAL_WEBHOOK_ID=your-webhook-id
# Recurring billing plan ids per METARDU plan (optional; one-off orders work without them)
# PAYPAL_PLAN_PRO=P-XXXXXXX
# PAYPAL_PLAN_TEAM=P-XXXXXXX
# PAYPAL_PLAN_FIRM=P-XXXXXXX
# PAYPAL_PLAN_ENTERPRISE=P-XXXXXXX

# ─── AI (optional) ───
ANTHROPIC_API_KEY=sk-ant-your-key

# ─── Monitoring (optional) ───
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Python Worker ───
PYTHON_COMPUTE_URL=http://metardu-worker:8000
WORKER_SECRET=your-worker-secret

# ─── Docker ───
HOSTNAME=0.0.0.0
NODE_ENV=production
DISABLE_PWA=false

# ─── CORS ───
CORS_ORIGIN=https://metardu.space

# ─── Email (optional) ───
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email-user
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@metardu.space

# ─── SMS (optional, Africa's Talking) ───
AFRICAS_TALKING_USERNAME=your-username
AFRICAS_TALKING_API_KEY=your-api-key
AFRICAS_TALKING_SENDER_ID=METARDU
