{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "plugins": ["metardu"],
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "rules": {
    "react/no-unescaped-entities": "off",
    "@next/next/no-page-custom-font": "off",

    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unsafe-assignment": "warn",
    "@typescript-eslint/no-unsafe-member-access": "warn",
    "@typescript-eslint/no-unsafe-call": "warn",
    "@typescript-eslint/no-unsafe-argument": "warn",
    "@typescript-eslint/no-unsafe-return": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "@typescript-eslint/no-non-null-assertion": "warn",
    "@typescript-eslint/ban-ts-comment": "warn",
    "@typescript-eslint/prefer-as-const": "warn",
    "@typescript-eslint/no-require-imports": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "react-hooks/purity": "off",
    "react/display-name": "off",
    "react/prop-types": "off",
    "react-compiler/react-compiler": "off",
    "@next/next/no-img-element": "off",
    "@next/next/no-html-link-for-pages": "off",
    "prefer-const": "warn",
    "no-unused-vars": "off",
    "no-console": "warn",
    "no-debugger": "warn",
    // allowEmptyCatch (2026-08-04): the 53 `catch {}` one-liners across the
    // codebase are deliberate error-swallowing (best-effort fallbacks on
    // optional reads / cleanups). Empty NON-catch blocks stay flagged.
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-irregular-whitespace": "warn",
    "no-case-declarations": "off",
    "no-fallthrough": "warn",
    "no-mixed-spaces-and-tabs": "warn",
    "no-redeclare": "warn",
    "no-undef": "off",
    "no-unreachable": "warn",
    "no-useless-escape": "warn",
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "TSInterfaceDeclaration[id.name='SurveyPoint']",
        "message": "Do not declare a local 'SurveyPoint' interface. Import it from '@/types/surveyPoint' instead. If you need a different shape, use Point2D / Point3D / SurveyPointWithCode / SurveyPoint3D, or name your interface differently (e.g. 'SurveyPointRow')."
      },
      {
        "selector": "CallExpression Literal[value=/^EPSG:21\\d{2}$/]",
        "message": "T1.5 (2026-07-09): Hardcoded EPSG:21xxx in a function call — use currentUtmEpsg from MapReactContext instead. Hardcoded CRS literals cause silent wrong-coordinate bugs outside UTM Zone 37S (Mombasa, Kisumu, Turkana). See MapClient.tsx currentUtmEpsg for the pattern."
      },
      {
        "selector": "CallExpression Literal[value=/^EPSG:3273\\d$/]",
        "message": "T1.5 (2026-07-09): Hardcoded EPSG:3273x in a function call — use currentUtmEpsg from MapReactContext instead."
      }
    ],

    /* ── jsx-a11y (#A11Y) ───────────────────────────────────────────────────
     * CI lint gate enforces --max-warnings 0 on changed files, so new a11y
     * violations in touched code are caught before merge.
     *
     * These rules are at zero violations codebase-wide after the A11Y sweep
     * (2026-08-03) — enforced as errors so regressions block CI:
     */
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      { "controlComponents": ["RadioGroupItem"] }
    ],
    "jsx-a11y/aria-proptypes": "error",
    /* LOCAL RULE (2026-08-04): ESLint version of scripts/aria-label-gate.mjs —
     * bans placeholder-like / junk aria-labels (empty, punctuation, generic
     * phrases, crunched header text, or aria-label duplicating its own
     * placeholder) so accessible names can't regress. Fires in the editor,
     * `next lint`, and the changed-files lint ratchet, in addition to the
     * whole-repo CI regex gate. Shipped via eslint-plugin-metardu (file: dep). */
    "metardu/no-placeholder-as-aria-label": "error"
    /* NOTE (2026-08-03): no-static-element-interactions,
     * click-events-have-key-events, and mouse-events-have-key-events are
     * STILL systemic across the codebase and are intentionally NOT enabled
     * here. The CI lint gate lints whole changed files with --max-warnings 0,
     * so any warn/error rule with existing codebase-wide violations would
     * block every PR that touches a dirty file. They will be re-added (as
     * errors) once the remaining interaction sweep drives them to zero
     * codebase-wide. */
  },
  "overrides": [
    {
      "files": [
        "src/lib/map/**/*.ts",
        "src/lib/survey/**/*.ts",
        "src/lib/geodesy/**/*.ts",
        "src/lib/geo/**/*.ts",
        "src/app/map/**/*.tsx",
        "src/app/map/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unsafe-assignment": "warn",
        "@typescript-eslint/no-unsafe-member-access": "warn",
        "@typescript-eslint/no-unsafe-call": "warn",
        "@typescript-eslint/no-unsafe-argument": "warn",
        "@typescript-eslint/no-unsafe-return": "warn"
      }
    }
  ]
}